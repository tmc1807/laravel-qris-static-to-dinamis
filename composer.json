{
    "name": "tmc1807/laravel-qris-static-to-dinamis",
    "description": "Convert static QRIS payloads into dynamic QRIS with a fixed amount for Laravel.",
    "keywords": [
        "laravel",
        "qris",
        "qr-code",
        "emvco",
        "payment",
        "indonesia",
        "dynamic-qris"
    ],
    "license": "MIT",
    "type": "library",
    "require": {
        "php": "^8.2",
        "ext-mbstring": "*",
        "bacon/bacon-qr-code": "^3.0",
        "illuminate/http": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "illuminate/view": "^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "khanamiryan/qrcode-detector-decoder": "^2.0",
        "laravel/pint": "^1.13",
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "pestphp/pest": "^3.0"
    },
    "suggest": {
        "ext-gd": "Required to render QR codes as PNG (SVG works without it)."
    },
    "autoload": {
        "psr-4": {
            "Tmc1807\\LaravelQrisStaticToDinamis\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tmc1807\\LaravelQrisStaticToDinamis\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Tmc1807\\LaravelQrisStaticToDinamis\\QrisServiceProvider"
            ],
            "aliases": {
                "Qris": "Tmc1807\\LaravelQrisStaticToDinamis\\Facades\\Qris"
            }
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "pint": "vendor/bin/pint"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
